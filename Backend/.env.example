# Copiar a .env y ajustar solo si hace falta.
# Cada servicio lee PORT; los valores por defecto son:
#   gateway 3000, catalog 3001, orders 3002.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# JWT RS256 (gateway, catalog y orders)
# Fuente de la clave pública: usa JWT_PUBLIC_KEY o JWT_JWKS_URL, no ambas.
# Genera un par de desarrollo con: npm run jwt:keys
# JWT_PUBLIC_KEY=base64_del_PEM_SPKI
# JWT_JWKS_URL=http://security:8000/.well-known/jwks.json
JWT_ISSUER=perfumespayday-security
JWT_AUDIENCE=perfumespayday-api

# Gateway
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
PROXY_TIMEOUT_MS=5000
SECURITY_SERVICE_URL=http://localhost:8000
CATALOG_SERVICE_URL=http://localhost:3001
ORDERS_SERVICE_URL=http://localhost:3002

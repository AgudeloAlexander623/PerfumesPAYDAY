ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

JWT_ISSUER=perfumespayday-security
JWT_AUDIENCE=perfumespayday-api
JWT_ACCESS_TTL_SECONDS=900

# Genera un par de desarrollo con: .venv/bin/python scripts/generate_jwt_keys.py
JWT_PRIVATE_KEY=base64_del_PEM_PKCS8

# Opcional: si se omite, la clave pública se deriva de la privada.
# JWT_PUBLIC_KEY=base64_del_PEM_SPKI

# Opcional: si se omite, el `kid` es la huella JWK (RFC 7638) de la clave.
# JWT_KEY_ID=clave-2026-11
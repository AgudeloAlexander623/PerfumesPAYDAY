ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

JWT_ISSUER=perfumesgold-security
JWT_AUDIENCE=perfumesgold-api
JWT_ACCESS_TTL_SECONDS=900

# Base de datos propia del servicio (ADR-0009).
DATABASE_URL=postgresql+asyncpg://security:security@localhost:5432/security_db

# Ciclo de vida de la sesión (ADR-0009).
REFRESH_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30

# Bloqueo temporal tras intentos fallidos de login.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Genera un par de desarrollo con: .venv/bin/python scripts/generate_jwt_keys.py
JWT_PRIVATE_KEY=base64_del_PEM_PKCS8

# Opcional: si se omite, la clave pública se deriva de la privada.
# JWT_PUBLIC_KEY=base64_del_PEM_SPKI

# Opcional: si se omite, el `kid` es la huella JWK (RFC 7638) de la clave.
# JWT_KEY_ID=clave-2026-11

# Rotación (ADR-0003): la clave anterior se publica durante 24 h para que los
# tokens ya emitidos sigan siendo válidos. Fija la hora real de la rotación en
# ISO 8601; si se omite, cuenta desde el arranque del servicio.
# JWT_KEY_OVERLAP_SECONDS=86400
# JWT_PREVIOUS_PRIVATE_KEY=base64_del_PEM_PKCS8_ANTERIOR
# JWT_PREVIOUS_PUBLIC_KEY=base64_del_PEM_SPKI_ANTERIOR
# JWT_PREVIOUS_KEY_ID=clave-2026-10
# JWT_PREVIOUS_KEY_ROTATED_AT=2026-11-24T02:00:00Z